---
import '../styles/global.css';
import { t, htmlLang } from '../i18n/utils.js';
import { categorySlugs } from '../i18n/slugs.js';

const {
  title,
  description,
  locale = 'en',
  alternates = [],
  ogImage = '/og-default.png'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogAbsolute = new URL(ogImage, Astro.site);
const ADSENSE = import.meta.env.PUBLIC_ADSENSE_ID;
const GA4 = import.meta.env.PUBLIC_GA4_ID;
const xDefault = alternates.find(a => a.hreflang === 'en')?.href;
const home = locale === 'de' ? '/de/' : '/';
---
<!DOCTYPE html>
<html lang={htmlLang(locale)} data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogAbsolute} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Skala Convert" />
  <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_US'} />
  <meta property="og:locale:alternate" content={locale === 'de' ? 'en_US' : 'de_DE'} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />

  <!-- Tema antes do primeiro pixel; localStorage pode falhar em WebView de chat -->
  <script is:inline>
    (function () {
      var t = 'light';
      try {
        t = localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {
        try { t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
        catch (e2) {}
      }
      document.documentElement.dataset.theme = t;
    })();
  </script>

  <!-- Consent Mode v2: tudo negado antes de qualquer script do Google -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500
    });
  </script>

  {GA4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4}`}></script>}
  {GA4 && <script is:inline set:html={`gtag('js', new Date()); gtag('config', '${GA4}');`}></script>}
  {ADSENSE && <script async crossorigin="anonymous"
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE}`}></script>}
</head>
<body>

<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href={home}>
      <svg class="mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="1.5" y="7" width="21" height="10" rx="2"/>
        <path d="M6 7v4M10 7v6M14 7v4M18 7v6" stroke-linecap="round"/>
      </svg>
      <b>Skala</b><span>Convert</span>
    </a>
    <div class="head-tools">
      <nav class="lang" aria-label="Language">
        <a href="/" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
        <a href="/de/" aria-current={locale === 'de' ? 'true' : undefined}>DE</a>
      </nav>
      <button class="btn-ghost" id="theme" type="button" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" stroke-linecap="round"/>
        </svg>
        <span id="theme-label">Dark</span>
      </button>
    </div>
  </div>
</header>

<slot />

<footer class="site-foot">
  <div class="wrap foot-row">
    <span>© {new Date().getFullYear()} Skala Convert</span>
    <nav aria-label="Legal">
      <a href={locale === 'de' ? '/de/datenschutz/' : '/privacy-policy/'}>{t('privacy', locale)}</a>
      <a href={locale === 'de' ? '/de/nutzungsbedingungen/' : '/terms-of-use/'}>{t('terms', locale)}</a>
      <a href={locale === 'de' ? '/' : '/de/'}>{locale === 'de' ? 'English' : 'Deutsch'}</a>
    </nav>
  </div>
</footer>

<script>
  const btn = document.getElementById('theme');
  const label = document.getElementById('theme-label');
  function sync() {
    const dark = document.documentElement.dataset.theme === 'dark';
    label.textContent = dark ? 'Light' : 'Dark';
    btn.setAttribute('aria-pressed', String(dark));
  }
  btn.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    sync();
  });
  sync();
</script>
</body>
</html>
