---
import Base from '../../../layouts/Base.astro';
import Converter from '../../../components/Converter.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { categoryKeys, categories } from '../../../data/categories.js';
import { routes } from '../../../data/pairs.js';
import { convert, formatNumber } from '../../../lib/convert.js';
import { t, symbols, unitName } from '../../../i18n/utils.js';
import { categorySlugs, categoryPath, pairPath, locales } from '../../../i18n/slugs.js';

export function getStaticPaths() {
  const locale = 'de';
  return categoryKeys.map(key => ({
    params: { category: categorySlugs[locale][key] },
    props: { categoryKey: key, locale }
  }));
}

const { categoryKey, locale } = Astro.props;
const seed = Astro.url.searchParams.get('v') ?? '1';
const unitKeys = Object.keys(categories[categoryKey].units);
const [defFrom, defTo] = [unitKeys[0], unitKeys[1]];
const name = t(`categories.${categoryKey}`, locale);
const related = routes.filter(r => r.category === categoryKey);

const alternates = locales.map(l => ({
  hreflang: l === 'de' ? 'de-DE' : 'en',
  href: new URL(categoryPath(categoryKey, l), 'https://skalaconvert.com').href
}));
---
<Base
  title={locale === 'de' ? `${name} umrechnen — Skala Convert` : `${name} Converter — Skala Convert`}
  description={locale === 'de'
    ? `${name} umrechnen. Exakte Faktoren, sofortiges Ergebnis, teilbare Links.`
    : `Convert ${name.toLowerCase()} units. Exact factors, instant results, shareable links.`}
  locale={locale}
  alternates={alternates}
>
  <main class="wrap">
    <div class="hero"><h1>{locale === 'de' ? `${name} umrechnen` : `${name} converter`}</h1></div>

    <Converter category={categoryKey} from={defFrom} to={defTo} seed={seed} locale={locale} showTabs={false} />

    <AdSlot name="inline" />

    {related.length > 0 && (
      <section class="block">
        <div class="block-head"><h2 class="section-title">{t('popular', locale)}</h2></div>
        <ul class="pairs">
          {related.map(r => (
            <li>
              <a href={pairPath(r.category, r.from, r.to, locale)}>
                <span class="p-name">{unitName(r.from, locale)} → {unitName(r.to, locale)}</span>
                <span class="p-eq">
                  1 {symbols[r.from]} = {formatNumber(convert(1, r.category, r.from, r.to), locale)} {symbols[r.to]}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <AdSlot name="footer" />
  </main>
</Base>
