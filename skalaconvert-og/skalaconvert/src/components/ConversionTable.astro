---
import { convert, formatNumber } from '../lib/convert.js';
import { t, symbols } from '../i18n/utils.js';
import { tableSteps } from '../lib/copy.js';

const { category, from, to, locale = 'en' } = Astro.props;
---
<section class="block" aria-labelledby="table-h">
  <h2 class="section-title" id="table-h">{t('conversionTable', locale)}</h2>
  <table class="conv-table">
    <thead>
      <tr><th scope="col">{symbols[from]}</th><th scope="col">{symbols[to]}</th></tr>
    </thead>
    <tbody>
      {tableSteps.map(n => (
        <tr>
          <td>{formatNumber(n, locale)}</td>
          <td>{formatNumber(convert(n, category, from, to), locale)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .conv-table { width: 100%; max-width: 420px; border-collapse: collapse; margin-top: var(--space-4); }
  .conv-table th, .conv-table td {
    text-align: left; padding: .5rem .75rem; border-bottom: 1px solid var(--border);
    font-family: var(--font-data); font-variant-numeric: tabular-nums; font-size: .9375rem;
  }
  .conv-table th { color: var(--text-muted); font-weight: 500; }
</style>
