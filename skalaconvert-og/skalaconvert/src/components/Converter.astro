---
import { categories, categoryKeys } from '../data/categories.js';
import { convert, formatNumber } from '../lib/convert.js';
import { t, unitLabel, symbols } from '../i18n/utils.js';

const {
  category = 'length',
  from = 'inch',
  to = 'centimeter',
  seed = '1',
  locale = 'en',
  showTabs = true
} = Astro.props;

const unitKeys = Object.keys(categories[category].units);
const seedNum = parseFloat(String(seed).replace(',', '.'));
const initial = Number.isFinite(seedNum) ? seedNum : 1;
const initialResult = convert(initial, category, from, to);

// Dicionários serializados para o script do cliente — evita duplicar dados.
const payload = {
  categories: Object.fromEntries(
    categoryKeys.map(k => [k, { affine: !!categories[k].affine, units: categories[k].units }])
  ),
  labels: Object.fromEntries(
    categoryKeys.flatMap(k => Object.keys(categories[k].units)).map(u => [u, unitLabel(u, locale)])
  ),
  symbols,
  strings: {
    invalidInput: t('invalidInput', locale),
    shareHint: t('shareHint', locale),
    copy: t('copy', locale),
    copied: t('copied', locale)
  },
  locale
};
---
<section class="converter" aria-label={t('tagline', locale)}>
  {showTabs && (
    <div class="cats" role="tablist" aria-label={t('allCategories', locale)}>
      {categoryKeys.map(k => (
        <button class="cat" role="tab" data-cat={k} aria-selected={k === category ? 'true' : 'false'}>
          {t(`categories.${k}`, locale)}
        </button>
      ))}
    </div>
  )}

  <div class="io">
    <div class="field">
      <label for="cv-in">{t('from', locale)}</label>
      <input id="cv-in" type="text" inputmode="decimal" value={initial} autocomplete="off" />
      <select id="cv-from" aria-label={t('from', locale)}>
        {unitKeys.map(u => <option value={u} selected={u === from}>{unitLabel(u, locale)}</option>)}
      </select>
    </div>

    <button type="button" class="swap" id="cv-swap" aria-label={t('swap', locale)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M4 7h16M4 7l3.2-3M4 7l3.2 3M20 17H4M20 17l-3.2-3M20 17l-3.2 3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="field">
      <label for="cv-out">{t('to', locale)}</label>
      <output id="cv-out">{formatNumber(initialResult, locale)}</output>
      <select id="cv-to" aria-label={t('to', locale)}>
        {unitKeys.map(u => <option value={u} selected={u === to}>{unitLabel(u, locale)}</option>)}
      </select>
    </div>
  </div>

  <div class="result-band">
    <div class="band-row">
      <p class="band-hint">{t('shareHint', locale)}</p>
      <output class="readout" id="cv-readout" aria-live="polite">
        {formatNumber(initial, locale)} {symbols[from]} = {formatNumber(initialResult, locale)} {symbols[to]}
      </output>
      <button class="btn" id="cv-copy" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/>
        </svg>
        <span id="cv-copy-label">{t('copy', locale)}</span>
      </button>
    </div>
  </div>

  <div class="all-units">
    <h2>{t('otherUnits', locale)}</h2>
    <ul id="cv-list">
      {unitKeys.map(u => (
        <li>
          <span class="u">{unitLabel(u, locale)}</span>
          <span class="v">{formatNumber(convert(initial, category, from, u), locale)}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script define:vars={{ payload, startCategory: category }}>
  const { categories, labels, symbols, strings, locale } = payload;
  let cat = startCategory;

  const $ = id => document.getElementById(id);
  const input = $('cv-in'), out = $('cv-out'), selFrom = $('cv-from'), selTo = $('cv-to');
  const list = $('cv-list'), copyBtn = $('cv-copy'), copyLabel = $('cv-copy-label');
  const readout = $('cv-readout'), hint = document.querySelector('.band-hint');

  function parseInput(raw) {
    if (typeof raw !== 'string') return NaN;
    return parseFloat(raw.trim().replace(/\s/g, '').replace(',', '.'));
  }

  const toC = { celsius: v => v, fahrenheit: v => (v - 32) * 5 / 9, kelvin: v => v - 273.15 };
  const fromC = { celsius: c => c, fahrenheit: c => c * 9 / 5 + 32, kelvin: c => c + 273.15 };

  function convert(v, c, from, to) {
    const d = categories[c];
    if (d.affine) return fromC[to](toC[from](v));
    return (v * d.units[from]) / d.units[to];
  }

  const SUP = { '-': '\u207B', '+': '', 0: '\u2070', 1: '\u00B9', 2: '\u00B2', 3: '\u00B3',
    4: '\u2074', 5: '\u2075', 6: '\u2076', 7: '\u2077', 8: '\u2078', 9: '\u2079' };

  function fmt(n) {
    if (!Number.isFinite(n)) return '';
    if (n === 0) return '0';
    const a = Math.abs(n);
    if (a < 1e-6 || a >= 1e12) {
      const [m, e] = n.toExponential(6).split('e');
      const mf = new Intl.NumberFormat(locale, { maximumFractionDigits: 6 }).format(parseFloat(m));
      return mf + '\u00D710' + [...e].map(c => SUP[c] ?? c).join('');
    }
    const digits = a >= 100 ? 4 : a >= 1 ? 6 : 9;
    return new Intl.NumberFormat(locale, {
      maximumFractionDigits: digits, useGrouping: a >= 10000
    }).format(n);
  }

  function fillSelects(preserve) {
    const keys = Object.keys(categories[cat].units);
    [selFrom, selTo].forEach((sel, i) => {
      sel.replaceChildren();
      keys.forEach(k => {
        const o = document.createElement('option');
        o.value = k;
        o.textContent = labels[k];
        sel.appendChild(o);
      });
      sel.value = preserve ? preserve[i] : keys[i === 0 ? 0 : Math.min(1, keys.length - 1)];
    });
  }

  function render() {
    const v = parseInput(input.value);
    if (!Number.isFinite(v)) {
      out.textContent = '\u2014';
      readout.textContent = '\u2014';
      hint.textContent = strings.invalidInput;
      copyBtn.disabled = true;
      list.replaceChildren();
      return;
    }
    copyBtn.disabled = false;
    hint.textContent = strings.shareHint;

    const r = convert(v, cat, selFrom.value, selTo.value);
    out.textContent = fmt(r);
    readout.textContent =
      fmt(v) + ' ' + symbols[selFrom.value] + ' = ' + fmt(r) + ' ' + symbols[selTo.value];

    const frag = document.createDocumentFragment();
    for (const u of Object.keys(categories[cat].units)) {
      const li = document.createElement('li');
      const a = document.createElement('span'); a.className = 'u'; a.textContent = labels[u];
      const b = document.createElement('span'); b.className = 'v';
      b.textContent = fmt(convert(v, cat, selFrom.value, u));
      li.append(a, b);
      frag.appendChild(li);
    }
    list.replaceChildren(frag);

    try {
      const url = new URL(location.href);
      url.searchParams.set('v', String(v));
      history.replaceState(null, '', url);
    } catch (e) {}
  }

  document.querySelectorAll('.cat').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat').forEach(b => b.setAttribute('aria-selected', 'false'));
      btn.setAttribute('aria-selected', 'true');
      cat = btn.dataset.cat;
      fillSelects();
      render();
    });
  });

  $('cv-swap').addEventListener('click', () => {
    const a = selFrom.value, b = selTo.value;
    selFrom.value = b; selTo.value = a;
    render();
  });

  // navigator.clipboard costuma ser bloqueada em WebView do WhatsApp/Telegram
  copyBtn.addEventListener('click', async () => {
    const text = readout.textContent.trim();
    if (!text || text === '\u2014') return;
    try {
      await navigator.clipboard.writeText(text);
    } catch (e) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:absolute;left:-9999px';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    copyLabel.textContent = strings.copied;
    setTimeout(() => { copyLabel.textContent = strings.copy; }, 1600);
  });

  input.addEventListener('input', render);
  selFrom.addEventListener('change', render);
  selTo.addEventListener('change', render);

  try {
    const seed = new URL(location.href).searchParams.get('v');
    if (seed) { input.value = seed; render(); }
  } catch (e) {}
</script>
